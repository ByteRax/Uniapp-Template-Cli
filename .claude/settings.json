{
  "permissions": {
    "allow": ["Bash(pnpm run lint*)", "Bash(pnpm run format*)", "Bash(pnpm run type-check*)", "Bash(npx eslint*)", "Bash(npx prettier*)", "Bash(npx vue-tsc*)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch*)", "Bash(git show*)", "Bash(jq *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; if [ -f \"$f\" ]; then npx prettier --write \"$f\" 2>/dev/null; npx eslint --fix \"$f\" 2>/dev/null; fi; } || true",
            "timeout": 30,
            "statusMessage": "Running prettier + eslint --fix"
          }
        ]
      }
    ]
  }
}
